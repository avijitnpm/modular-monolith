APP_NAME=modular-monolith
APP_ENV=development
SERVER_PORT=8080

POSTGRES_DB=app_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

DATABASE_URL=postgres://postgres:postgres@postgres:5432/app_db?sslmode=disable

ZITADEL_ISSUER=http://localhost:8081
ZITADEL_API_URL=http://localhost:8081
OIDC_ISSUER=http://localhost:8080
OIDC_AUDIENCE=modular-monolith
OIDC_CLIENT_ID=modular-monolith
OIDC_REDIRECT_URL=http://localhost:8080/api/v1/auth/callback
SESSION_SECRET=change-me-to-at-least-32-random-characters

DODO_API_KEY=dev_key
DODO_WEBHOOK_SECRET=dev_secret

OTEL_ENABLED=true
OTEL_SERVICE_NAME=modular-monolith
OTEL_EXPORTER_OTLP_ENDPOINT=http://openobserve:5080/api/default/v1/traces
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic YWRtaW5AZXhhbXBsZS5jb206U3Ryb25nUGFzc3dvcmQxMjM=

ZO_ROOT_USER_EMAIL=admin@example.com
ZO_ROOT_USER_PASSWORD=StrongPassword123
OPENOBSERVE_PORT=5080

TRAEFIK_HTTP_PORT=80
TRAEFIK_DASHBOARD_PORT=8081
