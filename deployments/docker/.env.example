# Production environment configuration
# Copy this to .env and fill in all values before deploying.
# DO NOT commit the .env file.

APP_NAME=modular-monolith
APP_IMAGE=modular-monolith-app:latest
SERVER_PORT=8080

# Domain & TLS (required)
DOMAIN=
ACME_EMAIL=

# Traefik Dashboard (generate: docker run --rm httpd:alpine htpasswd -nB admin)
# To disable dashboard, remove the traefik labels from docker-compose.yml
TRAEFIK_DASHBOARD_USERS=

# Database (required - no defaults)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?sslmode=disable

# OIDC (required)
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_CLIENT_ID=
OIDC_REDIRECT_URL=

# Session (required - must be >= 32 characters)
SESSION_SECRET=

# CORS
CORS_ORIGIN=

# Dodo Payments
DODO_API_KEY=
DODO_WEBHOOK_SECRET=

# OpenTelemetry
OTEL_ENABLED=true
OTEL_SERVICE_NAME=modular-monolith
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=false
OTEL_EXPORTER_OTLP_HEADERS=
